message =
    [ read-request, read-response ] /
    write-notification /
    [ request: close-request, response: close-response ]

read-request = { handle: uint, length: uint }
read-response = bytes
write-notification = [ handle: uint, data: bytes ]
close-request = uint
close-response = nil

message /= [ ping-request, ping-response ] / shutdown-notification

ping-request = []
ping-response = [ tstr, header ]
header = ( version: uint, flags: uint )
shutdown-notification = nil
