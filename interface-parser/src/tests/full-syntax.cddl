message = [ everything, everything ] / tagged

everything = {
    integers: [ 0, 42, -7, 0x1F, 0b101 ],
    floats: [ 1.5, -2.5e3, 0x1.8p1 ],
    ? text: "tab\there \u00e9 \u{1F600} \uD83D\uDE00",
    byte-strings: [ 'abc\'', h'00 ff  ; comment
        10', b64'aGVsbG8' ],
    ranges: 0..10 / 0...10,
    + "quoted key" => tstr .size (1..64),
    1: ~wrapped,
    2: &colors,
    3: &(a: 1, b: 2),
    optional-pair,
    * uint ^ => generic<tstr, bool>,
    2*3 any: #6.32(tstr) / #6.<uint>(bytes) / #1.5 / #7 / #,
}

wrapped = [ uint, uint ]
colors = ( red: 0, green: 1, blue: 2 )
optional-pair = ( ? left: uint, ? right: uint )
generic<K, V> = { * K => V }
tagged = #6.1(uint)
alias = colors
choices = { a: 1 // b: 2 }
extended = 1
extended /= 2
extensible-group = ( x: 1 )
extensible-group //= ( y: 2 )
